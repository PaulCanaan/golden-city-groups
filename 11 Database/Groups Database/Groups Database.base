filters:
  and:
    - file.inFolder("Groups Ministry/11 Database/Groups Database/All Groups") || file.inFolder("11 Database/Groups Database/All Groups")
    - file.ext == "md"
    - record_type == "group"
# Edit Leaders and Current Semester here; Current Leaders derives its rows from them.
# Clear Current Semester for groups no longer participating when the semester changes.
properties:
  file.name:
    displayName: Group Name
  branch:
    displayName: Branch
  group_status:
    displayName: Group Status
  current_semester:
    displayName: Current Semester
  semester:
    displayName: Semester
  leaders:
    displayName: Leaders
  location_area:
    displayName: Location Area
  meeting_day:
    displayName: Meeting Day
  meeting_time:
    displayName: Meeting Time
  launch_date:
    displayName: Launch Date
  planning_center_url:
    displayName: Planning Center
views:
  - type: table
    name: All Groups
    order:
      - file.name
      - branch
      - group_status
      - current_semester
      - semester
      - leaders
      - location_area
      - meeting_day
      - meeting_time
      - launch_date
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Current Semester
    filters:
      and:
        - current_semester == true
    order:
      - file.name
      - branch
      - group_status
      - current_semester
      - semester
      - leaders
      - meeting_day
      - meeting_time
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: City Groups
    filters:
      and:
        - branch == "City Groups"
    order:
      - file.name
      - group_status
      - leaders
      - location_area
      - meeting_day
      - meeting_time
  - type: table
    name: Collectives
    filters:
      and:
        - branch == "Collectives"
    order:
      - file.name
      - group_status
      - leaders
      - meeting_day
      - meeting_time
  - type: table
    name: Bible Clubs
    filters:
      and:
        - branch == "Bible Clubs"
    order:
      - file.name
      - group_status
      - leaders
      - location_area
      - meeting_day
      - meeting_time
  - type: table
    name: Active Groups
    filters:
      and:
        - group_status == "Active"
    order:
      - file.name
      - branch
      - leaders
      - location_area
      - meeting_day
      - meeting_time
