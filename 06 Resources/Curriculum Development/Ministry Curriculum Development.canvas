		{"id":"workspace-map","type":"text","text":"## Four workspace folders · supporting the five development stages","x":0,"y":1350,"width":3340,"height":100,"color":"#9098A1"},
		{"id":"phase-research","type":"text","text":"## 01 Research & Brainstorm\nCanvas Organizer\nLocal-only input inbox. Preserve originals; read dropped Canvases and actual linked notes.","x":0,"y":1510,"width":790,"height":240,"color":"#9098A1"},
		{"id":"phase-research-guide","type":"file","file":"Groups Ministry/06 Resources/Curriculum Development/01 Research & Brainstorm/README.md","x":0,"y":1800,"width":790,"height":150,"color":"#9098A1"},
		{"id":"phase-structure","type":"text","text":"## 02 Structure & Synthesize\nCanvas Organizer → Curriculum Editor\nFollow the development map; research real gaps; return synthesis/goals/outline to Paul.","x":850,"y":1510,"width":790,"height":240,"color":"#9098A1"},
		{"id":"phase-structure-guide","type":"file","file":"Groups Ministry/06 Resources/Curriculum Development/02 Structure & Synthesize/README.md","x":850,"y":1800,"width":790,"height":150,"color":"#9098A1"},
		{"id":"phase-develop","type":"text","text":"## 03 Develop Content\nCurriculum Editor → Resource Producer\nReal editable masters, scripts, leader notes, handouts, and slide drafts after direction review.","x":1700,"y":1510,"width":790,"height":240,"color":"#9098A1"},
		{"id":"phase-develop-guide","type":"file","file":"Groups Ministry/06 Resources/Curriculum Development/03 Develop Content/README.md","x":1700,"y":1800,"width":790,"height":150,"color":"#9098A1"},
		{"id":"phase-publish","type":"text","text":"## 04 Design & Publish\nResource Producer\nAccepted final PDFs/presentations/resources after Paul reviews the actual export.","x":2550,"y":1510,"width":790,"height":240,"color":"#9098A1"},
		{"id":"phase-publish-guide","type":"file","file":"Groups Ministry/06 Resources/Curriculum Development/04 Design & Publish/README.md","x":2550,"y":1800,"width":790,"height":150,"color":"#9098A1"},
		{"id":"human-handoffs","type":"text","text":"## Human review\nPaul confirms synthesis/goals/outline → reviews actual editable content → reviews actual export candidate.\nRecord response/date/version in the project brief. No reply is not confirmation. Library placement is not external publication.","x":0,"y":2040,"width":1640,"height":260,"color":"#9098A1"},
