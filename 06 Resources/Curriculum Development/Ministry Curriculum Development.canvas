	"nodes":[
		{"id":"title","type":"text","text":"# Ministry Curriculum Development\nBiblical Exegesis → Theological Synthesis → Formation Goals → Session Design → Resource Production","x":0,"y":-380,"width":3340,"height":130,"color":"#9098A1"},
		{"id":"legend-scripture","type":"text","text":"## Blue · Scripture\nText · context · exegesis\nContent color ≠ approval status.","x":0,"y":-210,"width":520,"height":150,"color":"#4A90D9"},
